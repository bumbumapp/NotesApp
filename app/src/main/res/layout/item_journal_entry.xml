<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_tile"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/entryDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jakarta_extrabold"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:textColor="?attr/Titel_1"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/entryWeekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jakarta_medium"
            android:maxLines="1"
            android:textColor="?attr/Titel_2"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/entryPreview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.1"
        android:maxLines="3"
        android:textColor="?attr/Titel_1"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/entryMood"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:textSize="22sp" />
</LinearLayout>
