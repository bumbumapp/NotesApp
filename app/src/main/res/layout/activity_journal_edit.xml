<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/BackgroundColor"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="-3dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:scaleType="centerInside"
            android:src="?attr/icon_a" />

        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/jakarta_extrabold"
            android:letterSpacing="-0.03"
            android:maxLines="1"
            android:text="@string/mod_journal"
            android:textColor="?attr/Titel_1"
            android:textSize="28sp" />

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete"
            android:scaleType="centerInside"
            android:src="@drawable/ic_delete"
            app:tint="?attr/Titel_2" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jakarta_bold"
                android:text="@string/journal_mood_question"
                android:textColor="?attr/Titel_1"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

            <TextView
                android:id="@+id/mood1"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_off"
                android:gravity="center"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/mood2"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_off"
                android:gravity="center"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/mood3"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_off"
                android:gravity="center"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/mood4"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_off"
                android:gravity="center"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/mood5"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_off"
                android:gravity="center"
                android:textSize="26sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/entryText"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:gravity="top|start"
                android:hint="@string/journal_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:lineSpacingMultiplier="1.15"
                android:minHeight="220dp"
                android:padding="16dp"
                android:textColor="?attr/Titel_1"
                android:textColorHint="?attr/Titel_2"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_amber_button"
                android:fontFamily="@font/jakarta_extrabold"
                android:gravity="center"
                android:text="@string/save"
                android:textColor="@color/dark_color"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
