<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/sheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/jakarta_extrabold"
        android:letterSpacing="-0.02"
        android:text="@string/task_edit"
        android:textColor="?attr/Titel_1"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/taskTitleInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_chip_soft"
        android:hint="@string/task_add_hint"
        android:importantForAutofill="no"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="4"
        android:minHeight="52dp"
        android:padding="14dp"
        android:textColor="?attr/Titel_1"
        android:textColorHint="?attr/Titel_2"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/jakarta_bold"
        android:text="@string/task_due_date"
        android:textColor="?attr/Titel_2"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/taskDueButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_chip_soft"
        android:fontFamily="@font/jakarta_semibold"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="?attr/Titel_1"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/jakarta_bold"
        android:text="@string/task_priority"
        android:textColor="?attr/Titel_2"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/priorityRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/jakarta_bold"
        android:text="@string/action_reminder"
        android:textColor="?attr/Titel_2"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/taskReminderButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_chip_soft"
        android:fontFamily="@font/jakarta_semibold"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="?attr/Titel_1"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/taskDelete"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/jakarta_bold"
            android:gravity="center"
            android:minWidth="88dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/delete"
            android:textColor="@color/colorDelete"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/taskSave"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_amber_button"
            android:fontFamily="@font/jakarta_extrabold"
            android:gravity="center"
            android:text="@string/save"
            android:textColor="@color/dark_color"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
